.page { min-height: 100vh; padding-bottom: 60rpx; }
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 32rpx 0;
}
.ttl { font-size: 40rpx; font-weight: 700; }
.me-link { font-size: 28rpx; color: #666; padding: 8rpx 0 8rpx 24rpx; }
.today { margin: 8rpx 32rpx 0; }
.ops { display: flex; padding: 20rpx 32rpx 4rpx; }
.op {
  font-size: 28rpx; color: #111; background: #fff;
  border-radius: 40rpx; padding: 14rpx 28rpx;
}

.empty { margin: 120rpx 60rpx 0; text-align: center; }
.empty-ttl { font-size: 34rpx; font-weight: 600; margin-bottom: 14rpx; }
.empty-btn { margin-top: 40rpx; }

.swipe-item { position: relative; margin: 24rpx 32rpx 0; }
.swipe-actions {
  position: absolute; right: 0; top: 0; bottom: 0;
  display: flex; border-radius: 0 28rpx 28rpx 0; overflow: hidden;
  opacity: 0;
}
.swipe-item.open .swipe-actions { opacity: 1; }
.act {
  width: 80px; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx;
}
.act.pin { background: #8a8a8a; }
.act.del { background: #e64340; }

.pc {
  position: relative; background: #fff; border-radius: 28rpx; padding: 28rpx;
  transition: transform .18s ease;
}
.pc.dead { opacity: .75; }
.pc-head { display: flex; align-items: center; gap: 14rpx; }
.pc-name { flex: 1; font-size: 34rpx; font-weight: 600; }
.pc-progress { display: flex; align-items: center; gap: 20rpx; margin: 20rpx 0 14rpx; }
.pc-pct { font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.pc-pct .u { font-size: 24rpx; font-weight: 500; margin-left: 4rpx; color: #666; }
.pc-bar { flex: 1; height: 12rpx; background: #f0f0f0; border-radius: 6rpx; overflow: hidden; }
.pc-bar-in { height: 100%; background: #111; border-radius: 6rpx; }
.pc-line { font-size: 26rpx; color: #555; margin-top: 8rpx; }
.pc-line.sub { color: #9a9a9a; }
.swipe-hint { text-align: center; margin-top: 32rpx; }

.page { padding-bottom: 60rpx; }
.me-head { display: flex; align-items: center; gap: 28rpx; }
.avatar-btn { padding: 0; margin: 0; background: transparent; line-height: 1; }
.avatar-btn::after { border: 0; }
.avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #111; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 600;
}
.me-info { flex: 1; }
.nick { font-size: 34rpx; font-weight: 600; margin-bottom: 10rpx; }
.nick-ph { color: #b5b5b5; font-weight: 400; }

.menu { padding: 0 28rpx; }
.mi {
  display: flex; justify-content: space-between; align-items: center;
  padding: 30rpx 0; font-size: 30rpx; border-top: 1px solid #f2f2f2;
}
.mi:first-child { border-top: 0; }
.arrow { color: #9a9a9a; font-size: 26rpx; }

.legal-body { max-height: 50vh; font-size: 26rpx; color: #555; line-height: 1.8; }
.day-btn { margin-top: 20rpx; }

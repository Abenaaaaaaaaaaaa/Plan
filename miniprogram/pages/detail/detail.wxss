.page { min-height: 100vh; padding-bottom: 160rpx; }

.seg { position: relative; display: flex; background: #fff; }
.seg .s {
  flex: 1; text-align: center; font-size: 30rpx; color: #8a8a8a;
  padding: 26rpx 0; position: relative;
}
.seg .s.on { color: #111; font-weight: 600; }
.seg .s.on::after {
  content: ''; position: absolute; bottom: 8rpx; left: 50%; margin-left: -32rpx;
  width: 64rpx; height: 6rpx; border-radius: 3rpx; background: #111;
}
.seg .more { position: absolute; right: 24rpx; top: 20rpx; font-size: 36rpx; color: #666; padding: 0 12rpx; }

.hero { padding: 28rpx 32rpx 8rpx; }
.hero-top { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.pct-wrap { display: flex; align-items: flex-end; justify-content: space-between; }
.pct-big { font-size: 88rpx; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
.pct-big .u { font-size: 34rpx; font-weight: 600; margin-left: 8rpx; color: #444; }
.pct-side { text-align: right; padding-bottom: 8rpx; }
.pct-acc { font-size: 34rpx; font-weight: 600; margin-bottom: 6rpx; }
.pct-tt { font-size: 26rpx; color: #9a9a9a; }
.hero-bar { height: 14rpx; border-radius: 7rpx; background: #ececec; margin-top: 28rpx; overflow: hidden; }
.hero-bar-in { height: 100%; background: #111; border-radius: 7rpx; }
.changed { margin-top: 16rpx; }

.sched { display: flex; padding: 28rpx 12rpx; }
.si { flex: 1; text-align: center; position: relative; }
.si + .si::before {
  content: ''; position: absolute; left: 0; top: 6rpx; bottom: 6rpx; width: 1px; background: #f0f0f0;
}
.si .k { font-size: 24rpx; color: #9a9a9a; margin-bottom: 10rpx; }
.si .v { font-size: 34rpx; font-weight: 600; }
.si .v.gap { color: #c46a00; }

.todaybar { display: flex; align-items: center; padding: 28rpx; }
.t-k { font-size: 26rpx; color: #9a9a9a; margin-right: 20rpx; }
.t-v { font-size: 42rpx; font-weight: 700; }
.t-u { font-size: 28rpx; color: #666; margin-left: 8rpx; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; padding: 0 32rpx; margin-top: 24rpx; }
.kpi { background: #fff; border-radius: 28rpx; padding: 28rpx; }
.kpi .k { font-size: 26rpx; color: #9a9a9a; margin-bottom: 14rpx; }
.kpi .v { font-size: 44rpx; font-weight: 700; }
.kpi .v .sm { font-size: 26rpx; font-weight: 400; color: #666; margin-left: 10rpx; }
.rline { display: flex; justify-content: space-between; font-size: 28rpx; margin-top: 10rpx; }
.rline .rl { color: #9a9a9a; }
.rtip { font-size: 24rpx; color: #9a9a9a; margin-top: 12rpx; }
.note { padding: 24rpx 32rpx; font-size: 24rpx; color: #9a9a9a; }

.rlegend { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 28rpx 32rpx 4rpx; }
.lg {
  display: flex; align-items: center; gap: 10rpx; background: #fff;
  border-radius: 40rpx; padding: 10rpx 22rpx; font-size: 24rpx; color: #666;
}
.dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; }
.dot.g { background: #07c160; }
.dot.y { background: #f2c94c; }
.dot.n { background: #f1f1f1; }
.dot.m { background: #576b95; border-radius: 50%; }
.rtools { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 32rpx 0; }
.tag { font-size: 24rpx; color: #576b95; padding: 8rpx 0 8rpx 20rpx; }

.empty { margin: 100rpx 0; text-align: center; }
.empty-ttl { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }

.mcard { background: #fff; border-radius: 28rpx; margin: 24rpx 32rpx 0; padding: 28rpx 24rpx; }
.mh { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20rpx; padding: 0 4rpx; }
.mt { font-size: 30rpx; font-weight: 600; }
.ms { font-size: 24rpx; color: #9a9a9a; }
.wk { display: grid; grid-template-columns: repeat(7, 1fr); font-size: 22rpx; color: #b5b5b5; text-align: center; margin-bottom: 12rpx; }
.mg { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cell {
  height: 84rpx; border-radius: 18rpx; background: #f5f5f5;
  font-size: 24rpx; font-weight: 600; color: #333;
  display: flex; align-items: center; justify-content: center; position: relative;
}
.cell .d { position: absolute; top: 8rpx; left: 10rpx; font-size: 20rpx; font-weight: 400; opacity: .7; }
.cell.met { background: #07c160; color: #fff; }
.cell.part { background: #f2c94c; color: #5c4400; }
.cell.out { background: transparent; }
.cell.today { box-shadow: inset 0 0 0 4rpx #111; }
.cell .man { position: absolute; right: 8rpx; bottom: 8rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #576b95; }

.footbar {
  position: fixed; left: 0; right: 0; bottom: 0; background: #f6f6f6;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

.day-total { font-size: 26rpx; color: #666; margin-bottom: 20rpx; }
.day-empty { padding: 20rpx 0; }
.day-row {
  display: flex; justify-content: space-between; font-size: 28rpx;
  padding: 20rpx 0; border-top: 1px solid #f2f2f2;
}
.day-btn { margin-top: 20rpx; }

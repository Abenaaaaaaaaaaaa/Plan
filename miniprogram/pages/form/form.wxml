<view class="page">
  <view class="card">
    <view class="label">计划名称</view>
    <input class="ipt" value="{{name}}" maxlength="20" placeholder="例如：每天读书" bindinput="onName" />
  </view>

  <view class="card">
    <view class="label">每日目标</view>
    <view class="pills">
      <view wx:for="{{presets}}" wx:key="*this"
        class="pill {{custom ? '' : (targetMin === item ? 'on' : '')}}"
        data-min="{{item}}" bindtap="choose">{{item}} 分钟</view>
      <view class="pill {{custom ? 'on' : ''}}" bindtap="chooseCustom">自定义</view>
    </view>
    <view wx:if="{{custom}}" class="custom-row">
      <input class="ipt custom-ipt" type="number" value="{{customVal}}" bindinput="onCustom" placeholder="分钟数" />
      <text class="unit">分钟 / 天</text>
    </view>
  </view>

  <view class="card">
    <view class="label">计划区间</view>
    <picker mode="date" value="{{start}}" bindchange="onStart">
      <view class="date-row"><text class="rl">开始日期</text><text class="rv">{{start}} ›</text></view>
    </picker>
    <picker mode="date" value="{{end}}" bindchange="onEnd">
      <view class="date-row"><text class="rl">结束日期</text><text class="rv">{{end}} ›</text></view>
    </picker>
  </view>

  <view class="save-wrap">
    <button class="btn" bindtap="save">保存</button>
  </view>
</view>
